# Reddit OAuth credentials
# Register a "script" type app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Slack Bot Token and your Slack User ID (for DM delivery)
# Create a Slack app at https://api.slack.com/apps, add the chat:write scope,
# install it to your workspace, and copy the Bot User OAuth Token (xoxb-...).
# Your User ID can be found in Slack: click your profile → "Copy member ID".
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_ID=U0123456789
